[o16, h16, l16, c16] = request.security("NASDAQ:SMCI", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // SMCI
[o17, h17, l17, c17] = request.security("NASDAQ:MU", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // MU
[o18, h18, l18, c18] = request.security("NASDAQ:MSTR", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // MSTR
[o19, h19, l19, c19] = request.security("NASDAQ:INTC", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // INTC
[o20, h20, l20, c20] = request.security("NASDAQ:COIN", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // COIN
[o21, h21, l21, c21] = request.security("NASDAQ:AMD", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // AMD
[o22, h22, l22, c22] = request.security("NASDAQ:HOOD", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // HOOD
[o23, h23, l23, c23] = request.security("NASDAQ:RIVN", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // RIVN
[o24, h24, l24, c24] = request.security("NYSE:ORCL", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // ORCL
[o25, h25, l25, c25] = request.security("NASDAQ:SPCX", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // SPCX
[o26, h26, l26, c26] = request.security("NASDAQ:NVDA", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // NVDA
[o27, h27, l27, c27] = request.security("NASDAQ:AVGO", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // AVGO
