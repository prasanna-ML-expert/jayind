//@version=6
indicator("Board Index — Jays + Gamma (Live)", shorttitle="BOARD 1111", overlay=false)

// LIVE equal-weight board index: 33 tickers (baked 2026-11-11 from hoodlist.csv), chained mean returns, base 100 @ 2026-10-14 close.
// Candles + EMA8s compute live from TradingView quotes IN THE CHART'S TIMEFRAME (daily candles on daily, weekly on weekly, hourly on hourly).
// Aggregate gamma walls baked daily. Regenerate daily for walls, weekly for composition: make_board_index_pine.py + publish_board_index_pine.py
// Chart must show history back to the base date or the chain never anchors (a label warns).

// --- 1. ticker OHLC in the chart's timeframe, one security call each (tuple = one call) ---
[o01, h01, l01, c01] = request.security("NASDAQ:CIFR", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // CIFR
[o02, h02, l02, c02] = request.security("NASDAQ:CRWV", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // CRWV
[o03, h03, l03, c03] = request.security("NASDAQ:ASTS", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // ASTS
[o04, h04, l04, c04] = request.security("NASDAQ:NBIS", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // NBIS
[o05, h05, l05, c05] = request.security("NASDAQ:IREN", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // IREN
[o06, h06, l06, c06] = request.security("NASDAQ:WULF", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // WULF
[o07, h07, l07, c07] = request.security("NASDAQ:RIOT", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // RIOT
[o08, h08, l08, c08] = request.security("NASDAQ:APLD", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // APLD
[o09, h09, l09, c09] = request.security("NASDAQ:MARA", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // MARA
[o10, h10, l10, c10] = request.security("NASDAQ:SNDK", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // SNDK
[o11, h11, l11, c11] = request.security("NASDAQ:RKLB", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // RKLB
[o12, h12, l12, c12] = request.security("NYSE:BE", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // BE
[o13, h13, l13, c13] = request.security("NASDAQ:MRNA", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // MRNA
[o14, h14, l14, c14] = request.security("NASDAQ:MRVL", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // MRVL
