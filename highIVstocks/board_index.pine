[o29, h29, l29, c29] = request.security("NYSE:NU", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // NU
[o30, h30, l30, c30] = request.security("NASDAQ:SOFI", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // SOFI
[o31, h31, l31, c31] = request.security("NASDAQ:TSLA", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // TSLA
[o32, h32, l32, c32] = request.security("NYSE:NOW", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // NOW
[o33, h33, l33, c33] = request.security("NASDAQ:META", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // META

// --- 2. field returns vs each ticker's own prior close ---
