[o05, h05, l05, c05] = request.security("NASDAQ:IREN", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // IREN
[o06, h06, l06, c06] = request.security("NASDAQ:WULF", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // WULF
