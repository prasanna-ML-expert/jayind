//@version=6
indicator("Board Index — Jays + Gamma (Live)", shorttitle="BOARD 1113", overlay=false, max_lines_count=100)

// LIVE equal-weight board index: 33 tickers (baked 2026-11-13 from hoodlist.csv), chained mean returns, base 100 @ 2026-10-14 close.
// Candles compute live from TradingView quotes IN THE CHART'S TIMEFRAME (daily candles on daily, weekly on weekly, hourly on hourly).
// Aggregate gamma walls baked daily. Regenerate daily for walls, weekly for composition: make_board_index_pine.py + publish_board_index_pine.py
// Chart must show history back to the base date or the chain never anchors (a label warns).

// --- 1. ticker OHLC in the chart's timeframe, one security call each (tuple = one call) ---
[o01, h01, l01, c01] = request.security("NASDAQ:CIFR", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // CIFR
[o02, h02, l02, c02] = request.security("NASDAQ:CRWV", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // CRWV
[o03, h03, l03, c03] = request.security("NASDAQ:ASTS", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // ASTS
