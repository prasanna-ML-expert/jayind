//@version=6
indicator("Board Index — Jays + Gamma", shorttitle="BOARD 1111", overlay=false)

// Board index: equal-weight hoodlist, base 100 @ Oct 14 close (chained mean daily returns).
// Candles 2026-10-15 -> 2026-11-10 (19 sessions), EMA8s baked from board_index.json, aggregate gamma walls baked from board_index_walls.json (2026-11-11).
// Regenerate daily: python3 ~/workspace/gex/make_board_index_pine.py  — values go stale after the last baked date.
// USE ON A DAILY CHART in a separate pane. Weekly EMA8: 5 weekly bars; monthly EMA8: 2 monthly bars — both thin, read with care.
// Jays Hull-MA-60 band NOT plotted: it needs 60 bars and the index has 19. The Jays read here is the multi-TF EMA8 trend (strength-tier legs).

var int[] dt = array.from(20261015, 20261016, 20261019, 20261020, 20261021, 20261022, 20261023, 20261026, 20261027, 20261028, 20261029, 20261030, 20261102, 20261103, 20261104, 20261105, 20261106, 20261109, 20261110)
var float[] io = array.from(96.21, 99.56, 97.46, 94.26, 99.18, 95.67, 92.42, 90.87, 93.93, 97.07, 96.32, 90.64, 89.84, 87.13, 88.72, 85.65, 82.76, 84.04, 85.86)
var float[] ih = array.from(102.14, 100.77, 98.96, 98.8, 101.46, 97.62, 94.89, 94.61, 97.97, 99.92, 98.73, 92.31, 91.4, 91.42, 92.41, 86.4, 85.67, 89.48, 89.74)
var float[] il = array.from(93.34, 93.52, 94.48, 92.57, 96.44, 91.11, 90.44, 88.82, 92.41, 94.62, 94.07, 86.46, 84.67, 86.0, 85.52, 75.71, 79.1, 82.67, 83.5)
var float[] ic = array.from(101.28, 94.77, 95.8, 96.56, 99.09, 92.98, 92.32, 91.91, 96.51, 98.92, 95.87, 89.16, 85.73, 89.97, 88.16, 78.58, 83.33, 87.76, 86.59)
var float[] ed = array.from(101.28, 99.83, 98.94, 98.41, 98.56, 97.32, 96.21, 95.25, 95.53, 96.29, 96.19, 94.63, 92.65, 92.06, 91.19, 88.39, 87.26, 87.37, 87.2)
var float[] ew = array.from(94.77, 94.77, 94.23, 94.23, 94.23, 94.23, 94.23, 93.1, 93.1, 93.1, 93.1, 93.1, 90.93, 90.93, 90.93, 90.93, 90.93, 89.96, 89.96)
var float[] em = array.from(89.16, 89.16, 89.16, 89.16, 89.16, 89.16, 89.16, 89.16, 89.16, 89.16, 89.16, 89.16, 88.59, 88.59, 88.59, 88.59, 88.59, 88.59, 88.59)

f_at(arr) =>
    int i = array.indexof(dt, year * 10000 + month * 100 + dayofmonth)
    i >= 0 ? array.get(arr, i) : na

float o  = f_at(io)
float h  = f_at(ih)
float l  = f_at(il)
float c  = f_at(ic)
float eD = f_at(ed)
float eW = f_at(ew)
float eM = f_at(em)

// --- index candles ---
plotcandle(o, h, l, c, title="Board index", colorup=color.new(#089981, 0), colordown=color.new(#f23645, 0), wickup=color.new(#089981, 0), wickdown=color.new(#f23645, 0), bordercolor=color.new(#787b86, 0))

// --- EMA8s, green when rising, red when falling (Jays multi-TF trend) ---
plot(eD, title="EMA8 daily", color=eD > eD[1] ? color.new(#089981, 0) : color.new(#f23645, 0), linewidth=2)
plot(eW, title="EMA8 weekly", color=eW > eW[1] ? color.new(#089981, 0) : color.new(#f23645, 0), linewidth=2)
plot(eM, title="EMA8 monthly", color=eM > eM[1] ? color.new(#089981, 0) : color.new(#f23645, 0), linewidth=2)

// --- aggregate gamma walls (Nov 11 levels, anchor = Nov 10 close) ---
float pw   = 85.92
float flip = 83.06
float mp   = 87.71
float cw   = 93.51
plot(cw,   title="CW",   color=color.new(#089981, 0), linewidth=1)
plot(pw,   title="PW",   color=color.new(#f23645, 0), linewidth=1)
plot(flip, title="Flip", color=color.new(#ff9800, 0), linewidth=1)
plot(mp,   title="MP",   color=color.new(#787b86, 0), linewidth=1)

// --- wall labels on the last bar ---
var label lbCW = na
var label lbPW = na
var label lbFL = na
var label lbMP = na
if barstate.islast
    label.delete(lbCW)
    label.delete(lbPW)
    label.delete(lbFL)
    label.delete(lbMP)
    lbCW := label.new(bar_index, cw,   "CW 93.51",   xloc=xloc.bar_index, style=label.style_label_left, color=color.new(#089981, 0), textcolor=color.white, size=size.small)
    lbPW := label.new(bar_index, pw,   "PW 85.92",   xloc=xloc.bar_index, style=label.style_label_left, color=color.new(#f23645, 0), textcolor=color.white, size=size.small)
    lbFL := label.new(bar_index, flip, "FLIP 83.06", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(#ff9800, 0), textcolor=color.white, size=size.small)
    lbMP := label.new(bar_index, mp,   "MP 87.71",   xloc=xloc.bar_index, style=label.style_label_left, color=color.new(#787b86, 0), textcolor=color.white, size=size.small)

// --- readout table ---
var table tb = table.new(position.top_right, 2, 9, border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, "Board index", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 0, "close 86.59  (2026-11-10)", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 1, "EMA8 daily", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 1, "87.20", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 2, "EMA8 weekly", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 2, "89.96  (5 wk bars)", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 3, "EMA8 monthly", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 3, "88.59  (2 mo bars)", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 4, "Jays tier", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 4, "Tier 4  (W>M:Y D>W:n Px>D:n)", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 5, "PW / Flip", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 5, "85.92 / 83.06", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 6, "MP / CW", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 6, "87.71 / 93.51", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 7, "Walls as of", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 7, "2026-11-11 (anchor 86.59)", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 8, "Gamma regime", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 8, "POSITIVE (close vs flip)", text_color=color.white, text_size=size.small)

// --- daily-chart guard ---
var label wrn = na
if not timeframe.isdaily and barstate.islast
    label.delete(wrn)
    wrn := label.new(bar_index, high, "Daily chart only — this indicator bakes daily index candles", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(#f23645, 0), textcolor=color.white, size=size.normal)

