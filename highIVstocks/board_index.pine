[o10, h10, l10, c10] = request.security("NASDAQ:SNDK", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // SNDK
[o11, h11, l11, c11] = request.security("NASDAQ:RKLB", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // RKLB
[o12, h12, l12, c12] = request.security("NYSE:BE", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // BE
[o13, h13, l13, c13] = request.security("NASDAQ:MRNA", timeframe.period, [open, high, low, close], lookahead=barmerge.lookahead_off)  // MRNA
