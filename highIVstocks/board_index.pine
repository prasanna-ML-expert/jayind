float rO26 = o26 / c26[1] - 1
float rH26 = h26 / c26[1] - 1
float rL26 = l26 / c26[1] - 1
float rC27 = c27 / c27[1] - 1
float rO27 = o27 / c27[1] - 1
float rH27 = h27 / c27[1] - 1
float rL27 = l27 / c27[1] - 1
float rC28 = c28 / c28[1] - 1
float rO28 = o28 / c28[1] - 1
float rH28 = h28 / c28[1] - 1
float rL28 = l28 / c28[1] - 1
float rC29 = c29 / c29[1] - 1
float rO29 = o29 / c29[1] - 1
float rH29 = h29 / c29[1] - 1
float rL29 = l29 / c29[1] - 1
float rC30 = c30 / c30[1] - 1
float rO30 = o30 / c30[1] - 1
float rH30 = h30 / c30[1] - 1
float rL30 = l30 / c30[1] - 1
float rC31 = c31 / c31[1] - 1
float rO31 = o31 / c31[1] - 1
float rH31 = h31 / c31[1] - 1
float rL31 = l31 / c31[1] - 1
float rC32 = c32 / c32[1] - 1
float rO32 = o32 / c32[1] - 1
float rH32 = h32 / c32[1] - 1
float rL32 = l32 / c32[1] - 1
float rC33 = c33 / c33[1] - 1
float rO33 = o33 / c33[1] - 1
float rH33 = h33 / c33[1] - 1
float rL33 = l33 / c33[1] - 1

// --- 3. mean returns (tickers missing either bar are skipped) ---
float sC = nz(rC01) + nz(rC02) + nz(rC03) + nz(rC04) + nz(rC05) + nz(rC06) + nz(rC07) + nz(rC08) + nz(rC09) + nz(rC10) + nz(rC11) + nz(rC12) + nz(rC13) + nz(rC14) + nz(rC15) + nz(rC16) + nz(rC17) + nz(rC18) + nz(rC19) + nz(rC20) + nz(rC21) + nz(rC22) + nz(rC23) + nz(rC24) + nz(rC25) + nz(rC26) + nz(rC27) + nz(rC28) + nz(rC29) + nz(rC30) + nz(rC31) + nz(rC32) + nz(rC33)
int nC = (na(rC01) ? 0 : 1) + (na(rC02) ? 0 : 1) + (na(rC03) ? 0 : 1) + (na(rC04) ? 0 : 1) + (na(rC05) ? 0 : 1) + (na(rC06) ? 0 : 1) + (na(rC07) ? 0 : 1) + (na(rC08) ? 0 : 1) + (na(rC09) ? 0 : 1) + (na(rC10) ? 0 : 1) + (na(rC11) ? 0 : 1) + (na(rC12) ? 0 : 1) + (na(rC13) ? 0 : 1) + (na(rC14) ? 0 : 1) + (na(rC15) ? 0 : 1) + (na(rC16) ? 0 : 1) + (na(rC17) ? 0 : 1) + (na(rC18) ? 0 : 1) + (na(rC19) ? 0 : 1) + (na(rC20) ? 0 : 1) + (na(rC21) ? 0 : 1) + (na(rC22) ? 0 : 1) + (na(rC23) ? 0 : 1) + (na(rC24) ? 0 : 1) + (na(rC25) ? 0 : 1) + (na(rC26) ? 0 : 1) + (na(rC27) ? 0 : 1) + (na(rC28) ? 0 : 1) + (na(rC29) ? 0 : 1) + (na(rC30) ? 0 : 1) + (na(rC31) ? 0 : 1) + (na(rC32) ? 0 : 1) + (na(rC33) ? 0 : 1)
float retC = nC > 0 ? sC / nC : na
float sO = nz(rO01) + nz(rO02) + nz(rO03) + nz(rO04) + nz(rO05) + nz(rO06) + nz(rO07) + nz(rO08) + nz(rO09) + nz(rO10) + nz(rO11) + nz(rO12) + nz(rO13) + nz(rO14) + nz(rO15) + nz(rO16) + nz(rO17) + nz(rO18) + nz(rO19) + nz(rO20) + nz(rO21) + nz(rO22) + nz(rO23) + nz(rO24) + nz(rO25) + nz(rO26) + nz(rO27) + nz(rO28) + nz(rO29) + nz(rO30) + nz(rO31) + nz(rO32) + nz(rO33)
int nO = (na(rO01) ? 0 : 1) + (na(rO02) ? 0 : 1) + (na(rO03) ? 0 : 1) + (na(rO04) ? 0 : 1) + (na(rO05) ? 0 : 1) + (na(rO06) ? 0 : 1) + (na(rO07) ? 0 : 1) + (na(rO08) ? 0 : 1) + (na(rO09) ? 0 : 1) + (na(rO10) ? 0 : 1) + (na(rO11) ? 0 : 1) + (na(rO12) ? 0 : 1) + (na(rO13) ? 0 : 1) + (na(rO14) ? 0 : 1) + (na(rO15) ? 0 : 1) + (na(rO16) ? 0 : 1) + (na(rO17) ? 0 : 1) + (na(rO18) ? 0 : 1) + (na(rO19) ? 0 : 1) + (na(rO20) ? 0 : 1) + (na(rO21) ? 0 : 1) + (na(rO22) ? 0 : 1) + (na(rO23) ? 0 : 1) + (na(rO24) ? 0 : 1) + (na(rO25) ? 0 : 1) + (na(rO26) ? 0 : 1) + (na(rO27) ? 0 : 1) + (na(rO28) ? 0 : 1) + (na(rO29) ? 0 : 1) + (na(rO30) ? 0 : 1) + (na(rO31) ? 0 : 1) + (na(rO32) ? 0 : 1) + (na(rO33) ? 0 : 1)
float retO = nO > 0 ? sO / nO : na
float sH = nz(rH01) + nz(rH02) + nz(rH03) + nz(rH04) + nz(rH05) + nz(rH06) + nz(rH07) + nz(rH08) + nz(rH09) + nz(rH10) + nz(rH11) + nz(rH12) + nz(rH13) + nz(rH14) + nz(rH15) + nz(rH16) + nz(rH17) + nz(rH18) + nz(rH19) + nz(rH20) + nz(rH21) + nz(rH22) + nz(rH23) + nz(rH24) + nz(rH25) + nz(rH26) + nz(rH27) + nz(rH28) + nz(rH29) + nz(rH30) + nz(rH31) + nz(rH32) + nz(rH33)
int nH = (na(rH01) ? 0 : 1) + (na(rH02) ? 0 : 1) + (na(rH03) ? 0 : 1) + (na(rH04) ? 0 : 1) + (na(rH05) ? 0 : 1) + (na(rH06) ? 0 : 1) + (na(rH07) ? 0 : 1) + (na(rH08) ? 0 : 1) + (na(rH09) ? 0 : 1) + (na(rH10) ? 0 : 1) + (na(rH11) ? 0 : 1) + (na(rH12) ? 0 : 1) + (na(rH13) ? 0 : 1) + (na(rH14) ? 0 : 1) + (na(rH15) ? 0 : 1) + (na(rH16) ? 0 : 1) + (na(rH17) ? 0 : 1) + (na(rH18) ? 0 : 1) + (na(rH19) ? 0 : 1) + (na(rH20) ? 0 : 1) + (na(rH21) ? 0 : 1) + (na(rH22) ? 0 : 1) + (na(rH23) ? 0 : 1) + (na(rH24) ? 0 : 1) + (na(rH25) ? 0 : 1) + (na(rH26) ? 0 : 1) + (na(rH27) ? 0 : 1) + (na(rH28) ? 0 : 1) + (na(rH29) ? 0 : 1) + (na(rH30) ? 0 : 1) + (na(rH31) ? 0 : 1) + (na(rH32) ? 0 : 1) + (na(rH33) ? 0 : 1)
float retH = nH > 0 ? sH / nH : na
float sL = nz(rL01) + nz(rL02) + nz(rL03) + nz(rL04) + nz(rL05) + nz(rL06) + nz(rL07) + nz(rL08) + nz(rL09) + nz(rL10) + nz(rL11) + nz(rL12) + nz(rL13) + nz(rL14) + nz(rL15) + nz(rL16) + nz(rL17) + nz(rL18) + nz(rL19) + nz(rL20) + nz(rL21) + nz(rL22) + nz(rL23) + nz(rL24) + nz(rL25) + nz(rL26) + nz(rL27) + nz(rL28) + nz(rL29) + nz(rL30) + nz(rL31) + nz(rL32) + nz(rL33)
int nL = (na(rL01) ? 0 : 1) + (na(rL02) ? 0 : 1) + (na(rL03) ? 0 : 1) + (na(rL04) ? 0 : 1) + (na(rL05) ? 0 : 1) + (na(rL06) ? 0 : 1) + (na(rL07) ? 0 : 1) + (na(rL08) ? 0 : 1) + (na(rL09) ? 0 : 1) + (na(rL10) ? 0 : 1) + (na(rL11) ? 0 : 1) + (na(rL12) ? 0 : 1) + (na(rL13) ? 0 : 1) + (na(rL14) ? 0 : 1) + (na(rL15) ? 0 : 1) + (na(rL16) ? 0 : 1) + (na(rL17) ? 0 : 1) + (na(rL18) ? 0 : 1) + (na(rL19) ? 0 : 1) + (na(rL20) ? 0 : 1) + (na(rL21) ? 0 : 1) + (na(rL22) ? 0 : 1) + (na(rL23) ? 0 : 1) + (na(rL24) ? 0 : 1) + (na(rL25) ? 0 : 1) + (na(rL26) ? 0 : 1) + (na(rL27) ? 0 : 1) + (na(rL28) ? 0 : 1) + (na(rL29) ? 0 : 1) + (na(rL30) ? 0 : 1) + (na(rL31) ? 0 : 1) + (na(rL32) ? 0 : 1) + (na(rL33) ? 0 : 1)
float retL = nL > 0 ? sL / nL : na

// --- 4. chain from the base anchor (first bar on/after the day after the base date) ---
// daily/intraday anchor = base level; weekly anchor = index close at end of base week; monthly anchor = index close at end of base month.
// ANCHOR WINDOW (fix 2026-11-11): the anchor bar must fall within one bar-period of the base date
// (daily +3d, weekly +8d, monthly +35d). Without this, a chart whose history starts AFTER the base
// date would anchor at its first bar with the fixed base value and silently scale the whole index down
// (e.g. history starting when the index was ~114 reads ~500 now). With the window, short history
// leaves the chain na and the 'No index data' label shows instead of a wrong level.
var float idxC = na
var float idxO = na
var float idxH = na
var float idxL = na
var bool anchored = false
float aVal = timeframe.isweekly ? 94.50 : timeframe.ismonthly ? 89.04 : 100
int aTime = timestamp(2026, 10, 15, 0, 0)
int aWin = timeframe.isweekly ? 8 * 86400000 : timeframe.ismonthly ? 35 * 86400000 : 3 * 86400000
int aTimeMax = aTime + aWin
if not anchored and time >= aTime and time <= aTimeMax and not na(retC)
    idxO := aVal * (1 + retO)
    idxH := aVal * (1 + retH)
    idxL := aVal * (1 + retL)
    idxC := aVal * (1 + retC)
    anchored := true
else if anchored and not na(retC)
    idxO := idxC[1] * (1 + retO)
    idxH := idxC[1] * (1 + retH)
    idxL := idxC[1] * (1 + retL)
    idxC := idxC[1] * (1 + retC)

// --- 5. index candles (chart timeframe; plotcandle takes one series color, not colorup/colordown) ---
color cndlCol = idxC >= idxO ? color.new(#089981, 0) : color.new(#f23645, 0)
plotcandle(idxO, idxH, idxL, idxC, title="Board index", color=cndlCol, wickcolor=cndlCol, bordercolor=color.new(#787b86, 0))

// --- 6. EMA8 of the index closes (chart timeframe; manual recursion, seeded on the first index close) ---
var float emaD = na
if not na(idxC)
    emaD := na(emaD) ? idxC : 2.0 / 9.0 * idxC + 7.0 / 9.0 * emaD[1]

// --- 7. EMA8 weekly / monthly (completed periods folded, in-progress period blended) ---
var float wEmaPrev = na
if timeframe.change("W") and not na(idxC[1])
    wEmaPrev := na(wEmaPrev) ? idxC[1] : 2.0 / 9.0 * idxC[1] + 7.0 / 9.0 * wEmaPrev
float eW = na(wEmaPrev) ? na : 2.0 / 9.0 * idxC + 7.0 / 9.0 * wEmaPrev
var float mEmaPrev = na
if timeframe.change("M") and not na(idxC[1])
    mEmaPrev := na(mEmaPrev) ? idxC[1] : 2.0 / 9.0 * idxC[1] + 7.0 / 9.0 * mEmaPrev
float eM = na(mEmaPrev) ? na : 2.0 / 9.0 * idxC + 7.0 / 9.0 * mEmaPrev

// --- 8. EMA8 lines, hardcoded Jays colors (monthly blue / weekly green / daily red) ---
// display=display.pane: line draws on the chart, value hidden from the legend.
plot(emaD, title="EMA8 chart", color=color.new(#f23645, 0), linewidth=2, display=display.pane)
plot(eW, title="EMA8 weekly", color=color.new(#089981, 0), linewidth=2, display=display.pane)
plot(eM, title="EMA8 monthly", color=color.new(#2962ff, 0), linewidth=2, display=display.pane)

// --- 9. Jays Hull-MA-60 BBMC band (jay_indicator.py), live from the index candles ---
// ma(src,len) = Hull-style WMA; BBMC = ma(close,60); bands = BBMC +/- 0.2 * EMA(true range,60).
ma(src, len) =>
    ta.wma(2 * ta.wma(src, int(len / 2)) - ta.wma(src, len), math.round(math.sqrt(len)))
float bbmc = ma(idxC, 60)
float prevC = nz(idxC[1], idxC)
float trIdx = math.max(idxH - idxL, math.max(math.abs(idxH - prevC), math.abs(idxL - prevC)))
float rangeMa = ta.ema(trIdx, 60)
float upperK = bbmc + 0.2 * rangeMa
float lowerK = bbmc - 0.2 * rangeMa
plot(bbmc, title="BBMC 60", color=color.new(#2962ff, 0), linewidth=2, display=display.pane)
pU = plot(upperK, title="BBMC upper", color=color.new(#2962ff, 0), linewidth=1, display=display.pane)
pL = plot(lowerK, title="BBMC lower", color=color.new(#2962ff, 0), linewidth=1, display=display.pane)
fill(pU, pL, color=color.new(#2962ff, 90))

// --- 10. Jays trend lines (Hull-8 per timeframe), green when rising, red when falling ---
// Trend = Hull WMA length 8 (jay_backtest.py primary); trend start = EMA crosses above trend.
// Weekly/monthly use completed periods only (like the backtest); direction persists through the period.
float trD = ma(idxC, 8)
// WMA of n elements in arr ending `off` before the last (off=0 = last n); partial windows OK.
wmaArrOff(float[] arr, int n, int off) =>
    int sz = array.size(arr)
    int m = math.max(0, math.min(n, sz - off))
    float s = 0.0
    float wsum = 0.0
    if m > 0
        for i = 0 to m - 1
            float v = array.get(arr, sz - 1 - off - i)
            float w = m - i
            s += v * w
            wsum += w
    s / wsum
// Hull-8 from an array of closes (needs the last 10 for the full WMA3; partial windows OK).
hullArr(float[] arr) =>
    float i0 = 2 * wmaArrOff(arr, 4, 0) - wmaArrOff(arr, 8, 0)
    float i1 = 2 * wmaArrOff(arr, 4, 1) - wmaArrOff(arr, 8, 1)
    float i2 = 2 * wmaArrOff(arr, 4, 2) - wmaArrOff(arr, 8, 2)
    (i0 * 3 + i1 * 2 + i2 * 1) / 6
var float[] wkCloses = array.new_float()
if timeframe.change("W") and not na(idxC[1])
    array.push(wkCloses, idxC[1])
    if array.size(wkCloses) > 12
        array.shift(wkCloses)
float trW = hullArr(wkCloses)
var float[] moCloses = array.new_float()
if timeframe.change("M") and not na(idxC[1])
    array.push(moCloses, idxC[1])
    if array.size(moCloses) > 12
        array.shift(moCloses)
float trM = hullArr(moCloses)
// Direction persists through the period (step functions only change at boundaries).
var bool wRising = false
var bool mRising = false
if not na(trW) and not na(trW[1]) and trW != trW[1]
    wRising := trW > trW[1]
if not na(trM) and not na(trM[1]) and trM != trM[1]
    mRising := trM > trM[1]
plot(trD, title="Trend chart", color=trD > trD[1] ? color.new(#089981, 0) : color.new(#f23645, 0), linewidth=3, display=display.pane)
plot(trW, title="Trend weekly", color=wRising ? color.new(#089981, 0) : color.new(#f23645, 0), linewidth=3, display=display.pane)
plot(trM, title="Trend monthly", color=mRising ? color.new(#089981, 0) : color.new(#f23645, 0), linewidth=3, display=display.pane)

// --- 11. aggregate gamma walls (baked, refresh daily) ---
float pw   = 85.82
float flip = 82.97
float mp   = 87.61
float cw   = 93.40
plot(cw,   title="CW",   color=color.new(#089981, 0), linewidth=1, display=display.pane)
plot(pw,   title="PW",   color=color.new(#f23645, 0), linewidth=1, display=display.pane)
plot(flip, title="Flip", color=color.new(#ff9800, 0), linewidth=1, display=display.pane)
plot(mp,   title="MP",   color=color.new(#787b86, 0), linewidth=1, display=display.pane)

// --- 12. Jays tier for the index (same three legs as strength_rank.py; on the daily chart this is the framework tier) ---
bool leg1 = not na(eW) and not na(eM) and eW > eM
bool leg2 = not na(emaD) and not na(eW) and emaD > eW
bool leg3 = not na(idxC) and not na(emaD) and idxC > emaD
int tier = (leg1 ? 4 : 0) + (leg2 ? 2 : 0) + (leg3 ? 1 : 0)

// --- 13. wall labels on the last bar (right of the bar, in the empty space) ---
var label lbCW = na
var label lbPW = na
var label lbFL = na
var label lbMP = na
if barstate.islast
    label.delete(lbCW)
    label.delete(lbPW)
    label.delete(lbFL)
    label.delete(lbMP)
    lbCW := label.new(bar_index + 2, cw,   "CW 93.40",   xloc=xloc.bar_index, style=label.style_label_left, color=color.new(#089981, 0), textcolor=color.white, size=size.small)
    lbPW := label.new(bar_index + 2, pw,   "PW 85.82",   xloc=xloc.bar_index, style=label.style_label_left, color=color.new(#f23645, 0), textcolor=color.white, size=size.small)
    lbFL := label.new(bar_index + 2, flip, "FLIP 82.97", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(#ff9800, 0), textcolor=color.white, size=size.small)
    lbMP := label.new(bar_index + 2, mp,   "MP 87.61",   xloc=xloc.bar_index, style=label.style_label_left, color=color.new(#787b86, 0), textcolor=color.white, size=size.small)

// --- 14. readout table (live values) ---
string tfName = timeframe.isdaily ? "daily" : timeframe.isweekly ? "weekly" : timeframe.ismonthly ? "monthly" : "intraday"
var table tb = table.new(position.top_right, 2, 13, border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, "Board index", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 0, "close " + str.tostring(idxC, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 1, "EMA8 " + tfName, text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 1, str.tostring(emaD, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 2, "EMA8 weekly", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 2, str.tostring(eW, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 3, "EMA8 monthly", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 3, str.tostring(eM, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 4, "Jays tier", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 4, "Tier " + str.tostring(tier) + "  (W>M:" + (leg1 ? "Y" : "n") + " D>W:" + (leg2 ? "Y" : "n") + " Px>D:" + (leg3 ? "Y" : "n") + ")", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 5, "PW / Flip", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 5, "85.82 / 82.97", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 6, "MP / CW", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 6, "87.61 / 93.40", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 7, "Walls as of", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 7, "2026-11-11 (anchor 86.49)", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 8, "Gamma regime", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 8, (idxC > flip ? "POSITIVE" : "NEGATIVE") + " (close vs flip)", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 9, "BBMC 60", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 9, na(bbmc) ? "n/a (<60 bars)" : str.tostring(bbmc, "#.##") + " · " + (idxC > upperK ? "ABOVE band" : idxC < lowerK ? "BELOW band" : "inside band"), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 10, "Trend " + tfName, text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 10, na(trD) ? "n/a" : str.tostring(trD, "#.##") + " · " + (trD > trD[1] ? "rising" : "falling"), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 11, "Trend weekly", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 11, na(trW) ? "n/a" : str.tostring(trW, "#.##") + " · " + (wRising ? "rising" : "falling"), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 12, "Trend monthly", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 12, na(trM) ? "n/a" : str.tostring(trM, "#.##") + " · " + (mRising ? "rising" : "falling"), text_color=color.white, text_size=size.small)

// --- 15. history guard (chain never anchored = chart starts after the base date) ---
var label nohist = na
if barstate.islast and na(idxC)
    label.delete(nohist)
    nohist := label.new(bar_index, high, "No index data — chart needs history back to 2026-10-14", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(#f23645, 0), textcolor=color.white, size=size.normal)

