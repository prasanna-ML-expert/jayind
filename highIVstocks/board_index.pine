float rO31 = o31 / c31[1] - 1
float rH31 = h31 / c31[1] - 1
float rL31 = l31 / c31[1] - 1
float rC32 = c32 / c32[1] - 1
float rO32 = o32 / c32[1] - 1
float rH32 = h32 / c32[1] - 1
float rL32 = l32 / c32[1] - 1
float rC33 = c33 / c33[1] - 1
float rO33 = o33 / c33[1] - 1
float rH33 = h33 / c33[1] - 1
float rL33 = l33 / c33[1] - 1

// --- 3. mean returns (tickers missing either bar are skipped) ---
float sC = nz(rC01) + nz(rC02) + nz(rC03) + nz(rC04) + nz(rC05) + nz(rC06) + nz(rC07) + nz(rC08) + nz(rC09) + nz(rC10) + nz(rC11) + nz(rC12) + nz(rC13) + nz(rC14) + nz(rC15) + nz(rC16) + nz(rC17) + nz(rC18) + nz(rC19) + nz(rC20) + nz(rC21) + nz(rC22) + nz(rC23) + nz(rC24) + nz(rC25) + nz(rC26) + nz(rC27) + nz(rC28) + nz(rC29) + nz(rC30) + nz(rC31) + nz(rC32) + nz(rC33)
int nC = (na(rC01) ? 0 : 1) + (na(rC02) ? 0 : 1) + (na(rC03) ? 0 : 1) + (na(rC04) ? 0 : 1) + (na(rC05) ? 0 : 1) + (na(rC06) ? 0 : 1) + (na(rC07) ? 0 : 1) + (na(rC08) ? 0 : 1) + (na(rC09) ? 0 : 1) + (na(rC10) ? 0 : 1) + (na(rC11) ? 0 : 1) + (na(rC12) ? 0 : 1) + (na(rC13) ? 0 : 1) + (na(rC14) ? 0 : 1) + (na(rC15) ? 0 : 1) + (na(rC16) ? 0 : 1) + (na(rC17) ? 0 : 1) + (na(rC18) ? 0 : 1) + (na(rC19) ? 0 : 1) + (na(rC20) ? 0 : 1) + (na(rC21) ? 0 : 1) + (na(rC22) ? 0 : 1) + (na(rC23) ? 0 : 1) + (na(rC24) ? 0 : 1) + (na(rC25) ? 0 : 1) + (na(rC26) ? 0 : 1) + (na(rC27) ? 0 : 1) + (na(rC28) ? 0 : 1) + (na(rC29) ? 0 : 1) + (na(rC30) ? 0 : 1) + (na(rC31) ? 0 : 1) + (na(rC32) ? 0 : 1) + (na(rC33) ? 0 : 1)
float retC = nC > 0 ? sC / nC : na
float sO = nz(rO01) + nz(rO02) + nz(rO03) + nz(rO04) + nz(rO05) + nz(rO06) + nz(rO07) + nz(rO08) + nz(rO09) + nz(rO10) + nz(rO11) + nz(rO12) + nz(rO13) + nz(rO14) + nz(rO15) + nz(rO16) + nz(rO17) + nz(rO18) + nz(rO19) + nz(rO20) + nz(rO21) + nz(rO22) + nz(rO23) + nz(rO24) + nz(rO25) + nz(rO26) + nz(rO27) + nz(rO28) + nz(rO29) + nz(rO30) + nz(rO31) + nz(rO32) + nz(rO33)
int nO = (na(rO01) ? 0 : 1) + (na(rO02) ? 0 : 1) + (na(rO03) ? 0 : 1) + (na(rO04) ? 0 : 1) + (na(rO05) ? 0 : 1) + (na(rO06) ? 0 : 1) + (na(rO07) ? 0 : 1) + (na(rO08) ? 0 : 1) + (na(rO09) ? 0 : 1) + (na(rO10) ? 0 : 1) + (na(rO11) ? 0 : 1) + (na(rO12) ? 0 : 1) + (na(rO13) ? 0 : 1) + (na(rO14) ? 0 : 1) + (na(rO15) ? 0 : 1) + (na(rO16) ? 0 : 1) + (na(rO17) ? 0 : 1) + (na(rO18) ? 0 : 1) + (na(rO19) ? 0 : 1) + (na(rO20) ? 0 : 1) + (na(rO21) ? 0 : 1) + (na(rO22) ? 0 : 1) + (na(rO23) ? 0 : 1) + (na(rO24) ? 0 : 1) + (na(rO25) ? 0 : 1) + (na(rO26) ? 0 : 1) + (na(rO27) ? 0 : 1) + (na(rO28) ? 0 : 1) + (na(rO29) ? 0 : 1) + (na(rO30) ? 0 : 1) + (na(rO31) ? 0 : 1) + (na(rO32) ? 0 : 1) + (na(rO33) ? 0 : 1)
float retO = nO > 0 ? sO / nO : na
float sH = nz(rH01) + nz(rH02) + nz(rH03) + nz(rH04) + nz(rH05) + nz(rH06) + nz(rH07) + nz(rH08) + nz(rH09) + nz(rH10) + nz(rH11) + nz(rH12) + nz(rH13) + nz(rH14) + nz(rH15) + nz(rH16) + nz(rH17) + nz(rH18) + nz(rH19) + nz(rH20) + nz(rH21) + nz(rH22) + nz(rH23) + nz(rH24) + nz(rH25) + nz(rH26) + nz(rH27) + nz(rH28) + nz(rH29) + nz(rH30) + nz(rH31) + nz(rH32) + nz(rH33)
int nH = (na(rH01) ? 0 : 1) + (na(rH02) ? 0 : 1) + (na(rH03) ? 0 : 1) + (na(rH04) ? 0 : 1) + (na(rH05) ? 0 : 1) + (na(rH06) ? 0 : 1) + (na(rH07) ? 0 : 1) + (na(rH08) ? 0 : 1) + (na(rH09) ? 0 : 1) + (na(rH10) ? 0 : 1) + (na(rH11) ? 0 : 1) + (na(rH12) ? 0 : 1) + (na(rH13) ? 0 : 1) + (na(rH14) ? 0 : 1) + (na(rH15) ? 0 : 1) + (na(rH16) ? 0 : 1) + (na(rH17) ? 0 : 1) + (na(rH18) ? 0 : 1) + (na(rH19) ? 0 : 1) + (na(rH20) ? 0 : 1) + (na(rH21) ? 0 : 1) + (na(rH22) ? 0 : 1) + (na(rH23) ? 0 : 1) + (na(rH24) ? 0 : 1) + (na(rH25) ? 0 : 1) + (na(rH26) ? 0 : 1) + (na(rH27) ? 0 : 1) + (na(rH28) ? 0 : 1) + (na(rH29) ? 0 : 1) + (na(rH30) ? 0 : 1) + (na(rH31) ? 0 : 1) + (na(rH32) ? 0 : 1) + (na(rH33) ? 0 : 1)
float retH = nH > 0 ? sH / nH : na
float sL = nz(rL01) + nz(rL02) + nz(rL03) + nz(rL04) + nz(rL05) + nz(rL06) + nz(rL07) + nz(rL08) + nz(rL09) + nz(rL10) + nz(rL11) + nz(rL12) + nz(rL13) + nz(rL14) + nz(rL15) + nz(rL16) + nz(rL17) + nz(rL18) + nz(rL19) + nz(rL20) + nz(rL21) + nz(rL22) + nz(rL23) + nz(rL24) + nz(rL25) + nz(rL26) + nz(rL27) + nz(rL28) + nz(rL29) + nz(rL30) + nz(rL31) + nz(rL32) + nz(rL33)
int nL = (na(rL01) ? 0 : 1) + (na(rL02) ? 0 : 1) + (na(rL03) ? 0 : 1) + (na(rL04) ? 0 : 1) + (na(rL05) ? 0 : 1) + (na(rL06) ? 0 : 1) + (na(rL07) ? 0 : 1) + (na(rL08) ? 0 : 1) + (na(rL09) ? 0 : 1) + (na(rL10) ? 0 : 1) + (na(rL11) ? 0 : 1) + (na(rL12) ? 0 : 1) + (na(rL13) ? 0 : 1) + (na(rL14) ? 0 : 1) + (na(rL15) ? 0 : 1) + (na(rL16) ? 0 : 1) + (na(rL17) ? 0 : 1) + (na(rL18) ? 0 : 1) + (na(rL19) ? 0 : 1) + (na(rL20) ? 0 : 1) + (na(rL21) ? 0 : 1) + (na(rL22) ? 0 : 1) + (na(rL23) ? 0 : 1) + (na(rL24) ? 0 : 1) + (na(rL25) ? 0 : 1) + (na(rL26) ? 0 : 1) + (na(rL27) ? 0 : 1) + (na(rL28) ? 0 : 1) + (na(rL29) ? 0 : 1) + (na(rL30) ? 0 : 1) + (na(rL31) ? 0 : 1) + (na(rL32) ? 0 : 1) + (na(rL33) ? 0 : 1)
float retL = nL > 0 ? sL / nL : na

// --- 4. chain from the base anchor (first bar on/after the day after the base date) ---
// daily/intraday anchor = base level; weekly anchor = index close at end of base week; monthly anchor = index close at end of base month.
// ANCHOR WINDOW (fix 2026-11-11): the anchor bar must fall within one bar-period of the base date
// (daily +3d, weekly +8d, monthly +35d). Without this, a chart whose history starts AFTER the base
// date would anchor at its first bar with the fixed base value and silently scale the whole index down
// (e.g. history starting when the index was ~114 reads ~500 now). With the window, short history
// leaves the chain na and the 'No index data' label shows instead of a wrong level.
var float idxC = na
var float idxO = na
var float idxH = na
var float idxL = na
var bool anchored = false
float aVal = timeframe.isweekly ? 94.50 : timeframe.ismonthly ? 89.04 : 100
int aTime = timestamp(2026, 10, 15, 0, 0)
int aWin = timeframe.isweekly ? 8 * 86400000 : timeframe.ismonthly ? 35 * 86400000 : 3 * 86400000
int aTimeMax = aTime + aWin
if not anchored and time >= aTime and time <= aTimeMax and not na(retC)
    idxO := aVal * (1 + retO)
    idxH := aVal * (1 + retH)
    idxL := aVal * (1 + retL)
    idxC := aVal * (1 + retC)
    anchored := true
else if anchored and not na(retC)
    idxO := idxC[1] * (1 + retO)
    idxH := idxC[1] * (1 + retH)
    idxL := idxC[1] * (1 + retL)
    idxC := idxC[1] * (1 + retC)

// --- 5. index candles (chart timeframe; plotcandle takes one series color, not colorup/colordown) ---
color cndlCol = idxC >= idxO ? color.new(#089981, 0) : color.new(#f23645, 0)
plotcandle(idxO, idxH, idxL, idxC, title="Board index", color=cndlCol, wickcolor=cndlCol, bordercolor=color.new(#787b86, 0))

// --- 9. Jays Hull-MA-60 BBMC band (jay_indicator.py), live from the index candles ---
// ma(src,len) = Hull-style WMA; BBMC = ma(close,60); bands = BBMC +/- 0.2 * EMA(true range,60).
ma(src, len) =>
    ta.wma(2 * ta.wma(src, int(len / 2)) - ta.wma(src, len), math.round(math.sqrt(len)))
float bbmc = ma(idxC, 60)
float prevC = nz(idxC[1], idxC)
float trIdx = math.max(idxH - idxL, math.max(math.abs(idxH - prevC), math.abs(idxL - prevC)))
float rangeMa = ta.ema(trIdx, 60)
float upperK = bbmc + 0.2 * rangeMa
float lowerK = bbmc - 0.2 * rangeMa
// Jays-style coloring (jay_indicator.py barColor): green when the close is above the upper
// band, red when below the lower band, white when inside the bands — not a fixed blue.
color bandCol = idxC > upperK ? color.new(#089981, 0) : idxC < lowerK ? color.new(#f23645, 0) : color.new(color.white, 0)
plot(bbmc, title="BBMC 60", color=bandCol, linewidth=2, display=display.pane)
pU = plot(upperK, title="BBMC upper", color=bandCol, linewidth=1, display=display.pane)
pL = plot(lowerK, title="BBMC lower", color=bandCol, linewidth=1, display=display.pane)
fill(pU, pL, color=color.new(bandCol, 90))

// --- 11. aggregate gamma walls: daily zigzag (baked history) + MP single line ---
// CW (green) and PW (red) are drawn as one small horizontal segment per
// bar, at that bar's wall level - the segments step day to day, so the
// two lines read as a zigzag upper bound (CW) and lower line (PW), ending
// at the last bar with the latest values. Flip is the same per-day
// segments but DOTTED (orange). MP stays a single horizontal line (gray)
// - its daily history is not tracked in opflow_history. The latest values
// below still feed the labels, the table, and the PCR band (fixed to PW).
// Segments use xloc.bar_time from the PREVIOUS bar's time to this bar's
// time (time[1] to time), NOT time-period to time - a fixed period breaks
// over weekends (Friday to Monday is 3 days, not 1, so time-period lands
// on Sunday and leaves a gap with no join). time[1] is always the prior
// candle, so the zigzag stays continuous across Fri->Mon. Each bar also
// draws a vertical connector at time[1] joining the previous bar's level
// to this bar's, same color/style - so green joins green, red joins red,
// dotted joins dotted, one continuous zigzag. Segments sit one bar left:
// a day's walls span the prior session's slot (same dating as PCR).
float pw   = 87.08
float flip = 84.84
float mp   = 90.29
float cw   = 93.27
// MP is a dotted segment on the latest candle only (not a full-width line).
var line mpLine = na
if barstate.islast and not na(time[1])
    line.delete(mpLine)
    mpLine := line.new(time, mp, time + (time - time[1]), mp, xloc=xloc.bar_time, color=color.new(#787b86, 0), width=1, style=line.style_dotted)
int[] wallDates = array.from(20261015, 20261016, 20261019, 20261020, 20261021, 20261022, 20261023, 20261026, 20261027, 20261028, 20261029, 20261030, 20261102, 20261103, 20261104, 20261105, 20261106, 20261109, 20261110, 20261111, 20261112, 20261113)
float[] wallPW = array.from(97.95, 99.59, 94.13, 94.55, 93.86, 95.95, 90.28, 90.71, 89.89, 94.70, 97.12, 93.43, 89.55, 86.11, 87.80, 86.78, 78, 82.37, 86.67, 85.82, 89.01, 87.08)
float[] wallCW = array.from(103.82, 105.06, 100.68, 101.36, 100.95, 101.70, 102.51, 100.89, 100.34, 102.24, 103.86, 105.96, 97.67, 95.18, 96.05, 93.78, 90.43, 92.99, 93.69, 93.40, 94.80, 93.27)
float[] wallFlip = array.from(94.69, 93.84, 91.61, 91.32, 90.62, 91.45, 91.83, 90.28, 88.78, 88.46, 88.81, 90.16, 86.40, 85.35, 84.43, 84.91, 84.16, 82.02, 81.92, 82.97, 86.30, 84.84)
int barDate = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
wallAt(int d, float[] vals) =>
    float v = na
    for i = 0 to array.size(wallDates) - 1
        if array.get(wallDates, i) == d
            v := array.get(vals, i)
            break
    v
// Walls as step lines: a native stepline plot draws each bar's horizontal
// segment exactly across that bar's width (edges aligned to the candle),
// which line.new cannot do - bar_index must be int (N to N+1 runs
// center-to-center) and bar_time snaps fractional times. offset=-1 shifts
// the whole step line one bar left, so a day's walls sit under the prior
// session's candle (same dating as PCR). Pine's plot has no dotted
// stepline, so the flip is solid orange here; the MP keeps its dotted
// line.new segment on the last bar only.
float cwDay = wallAt(barDate, wallCW)
float pwDay = wallAt(barDate, wallPW)
float flDay = wallAt(barDate, wallFlip)
plot(cwDay, title="CW", color=color.new(#089981, 0), linewidth=1, style=plot.style_stepline, offset=-1, display=display.pane)
plot(pwDay, title="PW", color=color.new(#f23645, 0), linewidth=1, style=plot.style_stepline, offset=-1, display=display.pane)
plot(flDay, title="Flip", color=color.new(#29b6f6, 0), linewidth=1, style=plot.style_stepline, offset=-1, display=display.pane)


// --- 12. Board PCR bars at the bottom of the pane (volume-style) ---
// PCR is a gamma-job value (prior session OI), baked daily with the walls.
// The value filed under a morning's date measures the PREVIOUS session,
// so each value is baked under the previous trading day's date and the
// bar plots exactly under that session's candle (exact-date match, no
// carry-forward - the current partial day has no bar yet). The PCR is
// MULTIPLIED by 10 and plotted as a bar rising UP from the band base
// (height = PCR x 10, so PCR 1.0 reaches the 50 line at base + 10). All
// bars rise from the base; color is kept - red when put-heavy (PCR > 1),
// green when call-heavy (PCR < 1). The 50 line stays as the PCR = 1.0
// reference. Height is clamped to the band top so a spike never leaves
// the band or touches the candles.
// The band is FIXED to the put wall (PW - 26 to PW - 12, 50 line at PW - 16),
// just below the candles, so the bars never overlap them. The 50 line is a
// straight horizontal reference at the PCR = 1.0 level. Bars are thick
// vertical LINES at the candle's own bar_index, rising from the band base.
// (box.new cannot center a bar on one candle: bar_index coordinates must
// be int, so a fractional bar_index - 0.5 does not compile - CE10123 - and
// xloc.bar_time snaps fractional times to whole bars, so a time-centered
// box lands on the boundary between two candles and straddles them. A
// vertical line at bar_index sits exactly on the candle's center.) Lines,
// not boxes or a histogram (a histogram draws from 0 and drags the pane
// scale to 0). Bar height is clamped to the 14-unit band top (PCR 1.4),
// so a spike never leaves the band.
int[] pcrDates = array.from(20261015, 20261016, 20261019, 20261020, 20261021, 20261022, 20261023, 20261026, 20261027, 20261028, 20261029, 20261030, 20261102, 20261103, 20261104, 20261105, 20261106, 20261109, 20261110, 20261111, 20261112)
float[] pcrVals = array.from(1.06, 1.09, 0.96, 0.92, 0.86, 1.27, 1.15, 1.03, 0.89, 0.83, 1.03, 1.11, 1.12, 0.93, 0.97, 1.59, 1.12, 0.89, 0.91, 0.78, 0.96)
pcrAt(int d) =>
    float v = na
    for i = 0 to array.size(pcrDates) - 1
        if array.get(pcrDates, i) == d
            v := array.get(pcrVals, i)
            break
    v
float pcr = pcrAt(barDate)
float pcrMult = nz(pcr, 1) * 10
float pcrBandLo = pw - 26
float pcrFifty = pcrBandLo + 10
float pcrPlot = pcrBandLo + math.min(pcrMult, 14)
color pcrCol = na(pcr) ? na : pcr > 1 ? color.new(#f23645, 0) : color.new(#089981, 0)
var line[] pcrLines = array.new_line()
if not na(pcr) and not na(pcrPlot)
    line ln = line.new(bar_index, pcrBandLo, bar_index, pcrPlot, color=pcrCol, width=4)
    array.push(pcrLines, ln)
    if array.size(pcrLines) > 60
        line.delete(array.shift(pcrLines))
plot(pcr, title="PCR", color=pcrCol, display=display.status_line)
// 50 line (= PCR 1.0) as a dotted line across the chart (plot has no dotted style).
// Start anchored at most 1249 bars back, NOT bar 0: Pine caps a line's reach at 1250 bars,
// so anchoring at bar 0 throws 'offset beyond historical limit 1250' once the chart grows past
// 1250 bars (daily hit it at the Nov 12 open; any intraday timeframe has far more bars).
var line fiftyLine = na
if barstate.islast
    line.delete(fiftyLine)
    fiftyLine := line.new(math.max(0, bar_index - 1249), pcrFifty, bar_index, pcrFifty, xloc=xloc.bar_index, color=color.new(#787b86, 0), width=1, style=line.style_dotted)
// --- 13. wall labels on the last bar (right of the bar, in the empty space) ---
var label lbCW = na
var label lbPW = na
var label lbFL = na
var label lbMP = na
if barstate.islast
    label.delete(lbCW)
    label.delete(lbPW)
    label.delete(lbFL)
    label.delete(lbMP)
    lbCW := label.new(bar_index + 2, cw,   "CW 93.27",   xloc=xloc.bar_index, style=label.style_label_left, color=na, textcolor=color.new(#089981, 0), size=size.small)
    lbPW := label.new(bar_index + 2, pw,   "PW 87.08",   xloc=xloc.bar_index, style=label.style_label_left, color=na, textcolor=color.new(#f23645, 0), size=size.small)
    lbFL := label.new(bar_index + 2, flip, "FLIP 84.84", xloc=xloc.bar_index, style=label.style_label_left, color=na, textcolor=color.new(#29b6f6, 0), size=size.small)
    lbMP := label.new(bar_index + 2, mp,   "MP 90.29",   xloc=xloc.bar_index, style=label.style_label_left, color=na, textcolor=color.new(#787b86, 0), size=size.small)

// --- 14. predicted next candle (ghost candle) ---
// From predict_board_candle.py (gamma-range + PCR + position + momentum
// heuristic). Drawn TWO bars out, so tomorrow the live candle forms at
// offset 1 and the prediction sits beside it at offset 2 instead of
// overlapping it. plotcandle has NO offset argument (CE10120), so the
// candle is drawn with lines: a thin wick (low-high) + a thick body
// (open-close, width 6, 50% transparent = ghosted) at bar_index+2.
// Pine has no hatched / striped fill, so the ghosted body + PRED label
// mark it as a prediction. It is a scenario, not data.
float predO = 88.31
float predH = 91.41
float predL = 85.21
float predC = 88.62
string predDate = "2026-11-13"
var line predWick = na
var line predBody = na
var label predLab = na
if barstate.islast
    line.delete(predWick)
    line.delete(predBody)
    label.delete(predLab)
    color predBodyCol = predC >= predO ? color.new(#089981, 50) : color.new(#f23645, 50)
    color predBordCol = predC >= predO ? color.new(#089981, 0) : color.new(#f23645, 0)
    predWick := line.new(bar_index + 2, predL, bar_index + 2, predH, xloc=xloc.bar_index, color=predBordCol, width=1, style=line.style_solid)
    predBody := line.new(bar_index + 2, predO, bar_index + 2, predC, xloc=xloc.bar_index, color=predBodyCol, width=6, style=line.style_solid)
    predLab := label.new(bar_index + 2, predH, "PRED " + predDate, xloc=xloc.bar_index, style=label.style_label_down, color=na, textcolor=color.new(#787b86, 0), size=size.small)

// --- 14. readout table REMOVED (user, Nov 11 evening) ---
// The top-right white-text table (Board index / PW-Flip / MP-CW / Walls as
// of / Gamma regime / BBMC 60 / PCR) blurred the candles where it overlapped
// them. Values still live in the legend (PCR), the wall labels, and the page.

// --- 15. history guard (chain never anchored = chart starts after the base date) ---
var label nohist = na
if barstate.islast and na(idxC)
    label.delete(nohist)
    nohist := label.new(bar_index, high, "No index data — chart needs history back to 2026-10-14", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(#f23645, 0), textcolor=color.white, size=size.normal)

