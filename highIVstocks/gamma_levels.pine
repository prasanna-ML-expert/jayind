drawLevel(level, tag, cl) =>
    var line ln = na
    var label lb = na
    if not na(level) and na(ln)
        ln := line.new(bar_index, level, bar_index + 1, level, xloc=xloc.bar_index, extend=extend.right, color=cl, style=line.style_solid, width=1)
        lb := label.new(bar_index, level, tag + " " + str.tostring(level), xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.white, 100), style=label.style_label_left, textcolor=cl, size=size.small)
    if not na(lb) and barstate.islast
        label.set_x(lb, bar_index)

drawLevel(cw, "CW", #089981)
drawLevel(pw, "PW", #F23645)
drawLevel(flip, "FLIP", #FF9800)
drawLevel(mp, "MP", #B0B0B0)

// --- predicted candle (ghost candle, per ticker) ---
// From predict_ticker_morning.py (gamma-range + PCR + momentum
// heuristic, backtest-tuned). Drawn TWO bars out, so the live
// candle forms at offset 1 and the prediction sits beside it at
// offset 2 instead of overlapping it. plotcandle has NO offset
// argument (CE10120), so the candle is drawn with lines: a thin
// wick (low-high) + a thick body (open-close, width 6, 50%
// transparent = ghosted) + a PRED label. It is a scenario, not data.
var line predWick = na
var line predBody = na
var label predLab = na
if barstate.islast and not na(prO) and not na(prC)
    line.delete(predWick)
    line.delete(predBody)
    label.delete(predLab)
    color predBodyCol = prC >= prO ? color.new(#089981, 50) : color.new(#F23645, 50)
    color predBordCol = prC >= prO ? color.new(#089981, 0) : color.new(#F23645, 0)
    predWick := line.new(bar_index + 2, prL, bar_index + 2, prH, xloc=xloc.bar_index, color=predBordCol, width=1, style=line.style_solid)
    predBody := line.new(bar_index + 2, prO, bar_index + 2, prC, xloc=xloc.bar_index, color=predBodyCol, width=6, style=line.style_solid)
    predLab := label.new(bar_index + 2, prH, "PRED 1113", xloc=xloc.bar_index, style=label.style_label_down, color=na, textcolor=color.new(#B0B0B0, 0), size=size.small)
