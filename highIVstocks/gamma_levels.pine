//@version=6
indicator("Gamma Levels", shorttitle="GAMMA 1016", overlay=true)

// === Gamma levels per ticker: update these numbers on each fresh options-data run ===
// cw = call wall (green) | pw = put wall (red) | flip = gamma flip (orange) | mp = max pain 10-23 (gray)

