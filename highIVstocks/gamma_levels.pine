drawLevel(level, tag, cl) =>
    var line ln = na
    var label lb = na
    if not na(level) and na(ln)
        ln := line.new(bar_index, level, bar_index + 1, level, xloc=xloc.bar_index, extend=extend.right, color=cl, style=line.style_solid, width=1)
        lb := label.new(bar_index, level, tag + " " + str.tostring(level), xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.white, 100), style=label.style_label_left, textcolor=cl, size=size.small)
    if not na(lb) and barstate.islast
        label.set_x(lb, bar_index)

drawLevel(cw, "CW", #089981)
drawLevel(pw, "PW", #F23645)
drawLevel(flip, "FLIP", #FF9800)
drawLevel(mp, "MP", #B0B0B0)

// (no prediction for today yet — run predict_ticker_morning.py after
// the gamma job and the premarket read, then regenerate this file)

// --- net-GEX profile: same data as the PW popup (gexdata.json) ---
// Horizontal bars on the right side of the chart, one per strike.
// Green = net call-heavy, red = net put-heavy (popup colors).
// Bars are RIGHT-ALIGNED: they share a common right edge
// (profMaxW + profGap bars right of the last bar) and extend
// LEFT toward the price, length proportional to |net GEX| /
// max|net GEX| for this ticker (max profMaxW bars). The longest
// bar's left edge sits profGap bars clear of the last candle.
// Redrawn on the last bar so the profile tracks the right edge
// as new bars form. Strikes with a zero-length bar are skipped.
var box[] profBoxes = array.new_box()
int profMaxW = 12
int profGap = 2
if barstate.islast
    for b in profBoxes
        box.delete(b)
    array.clear(profBoxes)
    int n = array.size(gexS)
    if n > 0
        float mx = 0.0
        for v in gexV
            mx := math.max(mx, math.abs(v))
        if mx == 0.0
            mx := 1.0
        int profRight = bar_index + 1 + profGap + profMaxW
        for i = 0 to n - 1
            float s = array.get(gexS, i)
            float v = array.get(gexV, i)
            int w = int(math.round(math.abs(v) / mx * profMaxW))
            if w >= 1
                float top = s
                float bot = s
                if n == 1
                    top := s + 0.5
                    bot := s - 0.5
                else if i == 0
                    float half = (array.get(gexS, 1) - s) / 2
                    top := s + half
                    bot := s - half
                else if i == n - 1
                    float half = (s - array.get(gexS, n - 2)) / 2
                    top := s + half
                    bot := s - half
                else
                    top := (s + array.get(gexS, i + 1)) / 2
                    bot := (s + array.get(gexS, i - 1)) / 2
                color c = v >= 0 ? color.new(#3fb950, 0) : color.new(#f85149, 0)
                box nb = box.new(profRight - w, top, profRight, bot, xloc=xloc.bar_index, bgcolor=c, border_color=c)
                array.push(profBoxes, nb)

// --- institutional (cap-structure) levels: same data as the strip bar ---
// Thin vertical column at the right edge, its left edge touching
// the GEX profile's right edge (capGap = 0).
// Blue = safe-buy zone, red = sell/supply zone (strip colors,
// translucent solid — Pine has no hatch, so the strip's 16% hatched
// fill becomes a 16% solid fill). Amber tick = convert strike,
// blue tick = institutional floor. Ticks already filtered at bake
// time by the strip capNear rule (within -50% / +100% of spot).
// Drawn only where cap data exists (29/33 tickers).
var box[] capBoxes = array.new_box()
var line[] capLines = array.new_line()
int capW = 3
int capGap = 0
if barstate.islast
    for b in capBoxes
        box.delete(b)
    array.clear(capBoxes)
    for l in capLines
        line.delete(l)
    array.clear(capLines)
    int capLeft = bar_index + 1 + profGap + profMaxW + capGap
    int capRight = capLeft + capW
    if not na(capBuyLo) and not na(capBuyHi)
        box bb = box.new(capLeft, capBuyHi, capRight, capBuyLo, xloc=xloc.bar_index, bgcolor=color.new(#58a6ff, 84), border_color=color.new(#58a6ff, 0))
        array.push(capBoxes, bb)
    if not na(capSellLo) and not na(capSellHi)
        box sb = box.new(capLeft, capSellHi, capRight, capSellLo, xloc=xloc.bar_index, bgcolor=color.new(#f85149, 84), border_color=color.new(#f85149, 0))
        array.push(capBoxes, sb)
    if not na(capConv)
        line cl = line.new(capLeft - 1, capConv, capRight + 1, capConv, xloc=xloc.bar_index, color=color.new(#d29922, 0), width=2)
        array.push(capLines, cl)
    if not na(capInst)
        line il = line.new(capLeft - 1, capInst, capRight + 1, capInst, xloc=xloc.bar_index, color=color.new(#58a6ff, 0), width=2)
        array.push(capLines, il)

// --- per-ticker PCR bars at the bottom (same design as the Board Index) ---
// PCR is a gamma-job value (prior session OI), baked daily with the walls.
// The value filed under a morning's date measures the PREVIOUS session,
// so each value is baked under the previous trading day's date and the
// bar plots exactly under that session's candle (exact-date match, no
// carry-forward - the current partial day has no bar yet). Bars rise from
// a band base anchored to pcrAnchor (min of lowest wall and lowest low
// over the aligned window, so the band sits below every candle in the
// PCR window). The band is 16% of the anchor tall; the 50 line (= PCR
// 1.0) sits 10/14 up the band; bar height = PCR x 10 units, clamped to
// the band top (PCR 1.4). Red when put-heavy (PCR > 1), green when
// call-heavy (PCR < 1). (Board Index uses fixed points; here the band
// scales with price so it works from $4 to $880.) Daily timeframe only.
int barDate = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
pcrAt(int d) =>
    float v = na
    if array.size(pcrD) > 0
        for i = 0 to array.size(pcrD) - 1
            if array.get(pcrD, i) == d
                v := array.get(pcrV, i)
                break
    v
float pcr = pcrAt(barDate)
float pcrBandH = pcrAnchor * 0.16
float pcrBandLo = pcrAnchor * 0.70
float pcrFifty = pcrBandLo + pcrBandH * 10 / 14
float pcrPlot = pcrBandLo + math.min(nz(pcr, 1) * pcrBandH * 10 / 14, pcrBandH)
color pcrCol = na(pcr) ? na : pcr > 1 ? color.new(#f23645, 0) : color.new(#089981, 0)
var line[] pcrLines = array.new_line()
if timeframe.isdaily and not na(pcr) and not na(pcrPlot) and not na(pcrBandLo)
    line ln = line.new(bar_index, pcrBandLo, bar_index, pcrPlot, color=pcrCol, width=4)
    array.push(pcrLines, ln)
    if array.size(pcrLines) > 60
        line.delete(array.shift(pcrLines))
plot(pcr, title="PCR", color=pcrCol, display=display.status_line)
var line pcrFiftyLine = na
if barstate.islast and timeframe.isdaily and not na(pcrFifty)
    line.delete(pcrFiftyLine)
    pcrFiftyLine := line.new(math.max(0, bar_index - 1249), pcrFifty, bar_index, pcrFifty, xloc=xloc.bar_index, color=color.new(#787b86, 0), width=1, style=line.style_dotted)
